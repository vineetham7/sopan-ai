rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // contentChunks is shared RAG content (curated OER, embedded once via
    // scripts/ingest.cjs) — every learner reads the same set, nobody writes
    // it from the client.
    match /contentChunks/{chunkId} {
      allow read: if true;
      allow write: if false;
    }

    // topicRealWorld is shared, too — real StackOverflow Q&A pulled once via
    // scripts/fetchRealWorldQuestions.cjs, same set for every learner.
    match /topicRealWorld/{topicId} {
      allow read: if true;
      allow write: if false;
    }

    // topicBenchmark is shared, too — real MMLU (gold-standard AI benchmark)
    // questions pulled once via scripts/fetchMMLUQuestions.cjs.
    match /topicBenchmark/{topicId} {
      allow read: if true;
      allow write: if false;
    }

    // topicGenerated is shared — Gemini-generated questions, written only by
    // the generateTopicQuestions Cloud Function (admin SDK bypasses rules),
    // never directly by a client.
    match /topicGenerated/{topicId} {
      allow read: if true;
      allow write: if false;
    }

    // feedCache holds getAiFeed's assembled pages (shared across every user,
    // ~45min TTL enforced in the function itself) — written only by that
    // Cloud Function, never read or written directly by a client.
    match /feedCache/{page} {
      allow read: if false;
      allow write: if false;
    }

    // Everything else is per-user: a learner (anonymous or upgraded) can
    // only ever read/write their own subtree. Anonymous auth is enabled and
    // trivial to obtain (any visitor gets one on page load), so create/update
    // also cap document size — otherwise a script that mints anonymous
    // sessions and writes huge documents has no rule-level limit stopping it
    // from running up real Firestore storage costs on the live billing account.
    match /users/{userId}/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.size() < 200000;
    }
  }
}
